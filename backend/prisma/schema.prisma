datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  progress     Progress[]
}

model Lesson {
  id         String   @id @default(uuid())
  topic      String
  difficulty String
  lessonJson Json
  createdAt  DateTime @default(now())

  progress   Progress[]
}

model Progress {
  id         String   @id @default(uuid())

  userId     String
  lessonId   String

  completion Int      @default(0)

  user       User     @relation(fields: [userId], references: [id])
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
}